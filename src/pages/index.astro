<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Affiliate Network Admin Dashboard</title>
  <style>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #0284c7;
      --accent-green: #16a34a;
      --accent-amber: #f59e0b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar Layout */
    .sidebar {
      width: 260px;
      background-color: #090d16;
      border-right: 1px solid var(--border-color);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .brand {
      font-size: 20px;
      font-weight: 700;
      color: var(--accent-blue);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .menu-item {
      padding: 12px 16px;
      border-radius: 8px;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .menu-item:hover, .menu-item.active {
      background-color: var(--bg-card);
      color: var(--text-main);
      border-left: 4px solid var(--accent-blue);
    }

    /* Main Content */
    .main-content {
      flex: 1;
      padding: 32px;
      overflow-y: auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }

    .header h1 {
      font-size: 24px;
      font-weight: 700;
    }

    .time-badge {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      color: var(--accent-green);
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 20px;
      border-radius: 12px;
    }

    .stat-title {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .stat-change {
      font-size: 12px;
      font-weight: 600;
    }

    .stat-change.up { color: var(--accent-green); }
    .stat-change.down { color: #ef4444; }

    /* Data Table Section */
    .table-container {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
    }

    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 14px;
    }

    th {
      color: var(--text-muted);
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      font-weight: 600;
    }

    td {
      padding: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    tr:last-child td {
      border-bottom: none;
    }

    .status-pill {
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }

    .status-pill.active {
      background: rgba(22, 163, 74, 0.2);
      color: var(--accent-green);
    }

    .status-pill.pending {
      background: rgba(245, 158, 11, 0.2);
      color: var(--accent-amber);
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand">⚡ TrackEngine Engine</div>
    <ul class="menu">
      <li class="menu-item active">Dashboard</li>
      <li class="menu-item">Offers Manager (20+)</li>
      <li class="menu-item">Affiliates / Publishers</li>
      <li class="menu-item">Real-Time Conversions</li>
      <li class="menu-item">Postback & APIs</li>
      <li class="menu-item">Network Settings</li>
    </ul>
  </aside>

  <!-- Main View -->
  <main class="main-content">
    <div class="header">
      <div>
        <h1>Performance Dashboard</h1>
        <p style="color: var(--text-muted); font-size: 14px; margin-top: 4px;">Live tracking metrics & conversions</p>
      </div>
      <div class="time-badge" id="liveClock">● Live Engine Running</div>
    </div>

    <!-- Analytics Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-title">Total Clicks</div>
        <div class="stat-value" id="totalClicks">124,590</div>
        <div class="stat-change up">+14.2% today</div>
      </div>

      <div class="stat-card">
        <div class="stat-title">Total Conversions</div>
        <div class="stat-value" id="totalConversions">3,840</div>
        <div class="stat-change up">+8.1% today</div>
      </div>

      <div class="stat-card">
        <div class="stat-title">Revenue</div>
        <div class="stat-value" id="totalRevenue">$18,420.50</div>
        <div class="stat-change up">CR: 3.08%</div>
      </div>

      <div class="stat-card">
        <div class="stat-title">Publisher Payout</div>
        <div class="stat-value" id="totalPayout">$11,200.00</div>
        <div class="stat-change down">Margin: 39.1%</div>
      </div>
    </div>

    <!-- Active Offers Data -->
    <div class="table-container">
      <div class="table-header">
        <h2>Top Performing Offers</h2>
      </div>
      <table>
        <thead>
          <tr>
            <th>Offer ID</th>
            <th>Offer Name</th>
            <th>Payout Type</th>
            <th>Clicks</th>
            <th>Conversions</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="offersBody">
          <tr>
            <td>#OFF-9021</td>
            <td>E-Commerce Smart Watch Campaign</td>
            <td>CPA ($24.00)</td>
            <td>14,230</td>
            <td>512</td>
            <td><span class="status-pill active">Active</span></td>
          </tr>
          <tr>
            <td>#OFF-8812</td>
            <td>VPN Mobile App Installation</td>
            <td>CPI ($3.50)</td>
            <td>45,100</td>
            <td>1,290</td>
            <td><span class="status-pill active">Active</span></td>
          </tr>
          <tr>
            <td>#OFF-7611</td>
            <td>Financial Lead Generation Form</td>
            <td>CPL ($12.00)</td>
            <td>8,920</td>
            <td>190</td>
            <td><span class="status-pill pending">Capped</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    // Pure Dynamic JS (No heavy framework dependencies)
    function updateLiveStats() {
      const clickEl = document.getElementById('totalClicks');
      let currentClicks = parseInt(clickEl.innerText.replace(',', ''));
      
      // Simulate live incoming traffic
      setInterval(() => {
        currentClicks += Math.floor(Math.random() * 5) + 1;
        clickEl.innerText = currentClicks.toLocaleString();
      }, 3000);
    }

    updateLiveStats();
  </script>
</body>
</html>