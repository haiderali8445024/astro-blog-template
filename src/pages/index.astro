---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const recentPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ScoreView.online | Credit & Background Verification Portal</title>
    <style>
      body { background-color: #0f172a; color: #f8fafc; font-family: system-ui, sans-serif; margin: 0; padding: 0; }
      header { background: #020617; border-bottom: 1px solid #1e293b; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
      .logo { font-size: 1.5rem; font-weight: 800; color: #38bdf8; text-decoration: none; }
      .nav a { color: #94a3b8; text-decoration: none; margin-left: 1.5rem; font-weight: 500; }
      .nav a:hover { color: #34d399; }
      .hero { text-align: center; padding: 4rem 1rem; max-width: 800px; margin: 0 auto; }
      .hero h1 { font-size: 2.8rem; margin-bottom: 1rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
      .card { background: #1e293b; border: 1px solid #334155; padding: 1.5rem; border-radius: 12px; }
      .btn { display: inline-block; background: #10b981; color: #020617; font-weight: bold; padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; margin-top: 1rem; }
      .badge { background: rgba(16, 185, 129, 0.1); color: #34d399; font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 20px; font-weight: bold; text-transform: uppercase; }
      .post-title { font-size: 1.2rem; font-weight: bold; color: #fff; text-decoration: none; display: block; margin: 0.5rem 0; }
      .post-title:hover { color: #34d399; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo">ScoreView<span style="color:#34d399">.online</span></a>
      <nav class="nav">
        <a href="/credit-check">Credit Check</a>
        <a href="/background-check">Background Check</a>
        <a href="/finance">Finance</a>
      </nav>
    </header>
    <main>
      <section class="hero">
        <h1>Smart Financial & Background Insights</h1>
        <p style="color: #94a3b8;">Instant credit score guidance, public record lookup resources, and strategic finance articles.</p>
      </section>
      <div class="grid">
        <div class="card">
          <h2>💳 Credit Check Hub</h2>
          <p style="color: #94a3b8;">Understand credit rating formulas, fix report errors, and track rating metrics.</p>
          <a href="/credit-check" class="btn">Explore Credit Tools</a>
        </div>
        <div class="card">
          <h2>🔍 Background Check Hub</h2>
          <p style="color: #94a3b8;">Verify public records, criminal history lookups, and identity check procedures.</p>
          <a href="/background-check" class="btn" style="background:#38bdf8;">Search Public Records</a>
        </div>
      </div>
      <h2 style="max-width:1100px; margin: 3rem auto 1rem; padding: 0 1rem;">Latest Articles</h2>
      <div class="grid">
        {recentPosts.map((post) => (
          <div class="card">
            <span class="badge">{post.data.category}</span>
            <a href={`/blog/${post.slug}`} class="post-title">{post.data.title}</a>
            <p style="color: #94a3b8; font-size: 0.9rem;">{post.data.description}</p>
          </div>
        ))}
      </div>
    </main>
  </body>
</html>